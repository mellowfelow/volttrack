# ── Reply Portal ──────────────────────────────────────────────
# Admin dashboard passcode (server-only, never sent to the browser)
ADMIN_PASSCODE=

# SMTP (nodemailer) — any SMTP provider (Gmail app-password, SES, Zoho, etc.)
EMAIL_SERVER_HOST=
EMAIL_SERVER_PORT=465
EMAIL_SERVER_USER=
EMAIL_SERVER_PASSWORD=
EMAIL_FROM=VoltTrack <info@volttrackhub.com>

# Upstash Redis (order + enquiry storage) — from console.upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
